{
  "entities": {
    "users": {
      "title": "User",
      "description": "System user profiles and employees",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "name": { "type": "string" },
        "firstName": { "type": "string" },
        "middleName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "pin": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "branch": { "type": "string" },
        "position": { "type": "string" },
        "hourlyRate": { "type": "number" },
        "dateHired": { "type": "string" },
        "status": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["id", "employeeId", "name", "role", "pin"]
    },
    "summaries": {
      "title": "AttendanceSummaryDaily",
      "description": "Daily attendance summaries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "department": { "type": "string" },
        "branch": { "type": "string" },
        "date": { "type": "string" },
        "weekday": { "type": "string" },
        "firstIn": { "type": "string" },
        "lastOut": { "type": "string" },
        "breakOut": { "type": "string" },
        "breakIn": { "type": "string" },
        "totalBreakMinutes": { "type": "number" },
        "netHoursWorked": { "type": "number" },
        "undertimeHours": { "type": "number" },
        "overtimeHours": { "type": "number" },
        "ctoHoursEarned": { "type": "number" },
        "targetHours": { "type": "number" },
        "status": { "type": "string" },
        "anomalies": { "type": "array", "items": { "type": "string" } },
        "punches": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "employeeId", "date"]
    },
    "punches": {
      "title": "BiometricPunch",
      "description": "Biometric punch logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "deviceId": { "type": "string" }
      },
      "required": ["id", "employeeId", "timestamp", "type"]
    },
    "disputes": {
      "title": "DisputeRequest",
      "description": "Attendance dispute requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "requestedClockIn": { "type": "string" },
        "requestedClockOut": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "employeeId", "reason", "status"]
    },
    "schedules": {
      "title": "WorkSchedule",
      "description": "Work schedule rosters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "department": { "type": "string" },
        "branch": { "type": "string" },
        "shiftName": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "workDays": { "type": "array", "items": { "type": "string" } },
        "effectiveDate": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "employeeId"]
    },
    "ctoRequests": {
      "title": "CtoRequest",
      "description": "CTO Leave and EARN requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "department": { "type": "string" },
        "branch": { "type": "string" },
        "requestType": { "type": "string" },
        "hoursRequested": { "type": "number" },
        "date": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "managerApproved": { "type": "boolean" },
        "payrollApproved": { "type": "boolean" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "employeeId"]
    },
    "ctoAdjustments": {
      "title": "CtoManualAdjustment",
      "description": "Manual CTO balance adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "adjustedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "employeeId", "amount"]
    },
    "warehouseCategories": {
      "title": "WarehouseCategory",
      "description": "Warehouse inventory stock categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "name", "updatedAt"]
    },
    "warehouseItems": {
      "title": "WarehouseInventoryItem",
      "description": "Branch-level warehouse inventory stock balances",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemCode": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "batchNo": { "type": "string" },
        "uom": { "type": "string" },
        "unitPrice": { "type": "number" },
        "branchCode": { "type": "string" },
        "branchName": { "type": "string" },
        "quantity": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "expiryDate": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "description", "category", "uom", "branchCode", "quantity"]
    },
    "stockMovements": {
      "title": "StockMovementEntry",
      "description": "Stock movement ledger for Stock In, Stock Out, Transfer In, and Transfer Out",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "string" },
        "movementType": { "type": "string" },
        "status": { "type": "string" },
        "branchCode": { "type": "string" },
        "branchName": { "type": "string" },
        "counterpartyBranchCode": { "type": "string" },
        "counterpartyBranchName": { "type": "string" },
        "fromBranchCode": { "type": "string" },
        "fromBranchName": { "type": "string" },
        "toBranchCode": { "type": "string" },
        "toBranchName": { "type": "string" },
        "itemId": { "type": "string" },
        "itemCode": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "batchNo": { "type": "string" },
        "uom": { "type": "string" },
        "unitPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "previousQty": { "type": "number" },
        "newQty": { "type": "number" },
        "refNumber": { "type": "string" },
        "transferNumber": { "type": "string" },
        "performedBy": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "date", "movementType", "branchCode", "description", "quantity", "refNumber"]
    },
    "stockTransfers": {
      "title": "StockTransferRequisition",
      "description": "Stock Transfer Requisition (STR) records across FBC branches",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transferNumber": { "type": "string" },
        "strRefNumber": { "type": "string" },
        "date": { "type": "string" },
        "fromBranchCode": { "type": "string" },
        "fromBranchName": { "type": "string" },
        "toBranchCode": { "type": "string" },
        "toBranchName": { "type": "string" },
        "items": { "type": "array" },
        "preparedBy": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedByUserId": { "type": "string" },
        "receivedBy": { "type": "string" },
        "receivedAt": { "type": "string" },
        "receivedByUserId": { "type": "string" },
        "receivedByRole": { "type": "string" },
        "remarks": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdByUserId": { "type": "string" }
      },
      "required": ["id", "transferNumber", "strRefNumber", "date", "fromBranchCode", "toBranchCode", "items", "preparedBy", "status"]
    },
    "storeTickets": {
      "title": "StoreTicket",
      "description": "Store concern requests submitted by branch users to admin with status and resolution tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "branch": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "attachments": { "type": "array" },
        "status": { "type": "string" },
        "requestedByUserId": { "type": "string" },
        "requestedByEmployeeId": { "type": "string" },
        "requestedByName": { "type": "string" },
        "requestedByRole": { "type": "string" },
        "adminNotes": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" },
        "resolvedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "statusHistory": { "type": "array" }
      },
      "required": ["id", "ticketNumber", "branch", "category", "priority", "subject", "description", "status", "requestedByName", "createdAt"]
    },
    "adminNotificationSettings": {
      "title": "AdminEmailNotificationConfig",
      "description": "Super Admin automatic email notification configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" },
        "recipientEmail": { "type": "string" },
        "enabledCategories": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" },
        "lastSentAt": { "type": "string" },
        "lastStatus": { "type": "string" },
        "lastError": { "type": "string" }
      },
      "required": ["id", "enabled", "recipientEmail", "enabledCategories", "updatedAt"]
    },
    "emailedAlerts": {
      "title": "EmailedAdminAlertRecord",
      "description": "Deduplication log of alerts already emailed to Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alertId": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "sentAt": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["id", "alertId", "recipientEmail", "sentAt"]
    },
    "adminEmailSettings": {
      "title": "AdminEmailSettings",
      "description": "Super Admin Gmail alert notification preferences (no OAuth tokens stored)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "enabled": { "type": "boolean" },
        "autoSendOnNewAlert": { "type": "boolean" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "lastSentAt": { "type": "string" },
        "lastSentSummary": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "recipientEmail", "enabled", "updatedAt"]
    }
  },
  "firestore": {
    "/warehouseCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/warehouseCategories" },
      "description": "Warehouse inventory categories"
    },
    "/warehouseItems/{itemId}": {
      "schema": { "$ref": "#/entities/warehouseItems" },
      "description": "Warehouse inventory stock items per branch"
    },
    "/stockMovements/{movementId}": {
      "schema": { "$ref": "#/entities/stockMovements" },
      "description": "Stock movement ledger entries"
    },
    "/stockTransfers/{transferId}": {
      "schema": { "$ref": "#/entities/stockTransfers" },
      "description": "Stock Transfer Requisition (STR) documents"
    },
    "/storeTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/storeTickets" },
      "description": "Store concern tickets submitted to admin"
    },
    "/adminNotificationSettings/{settingId}": {
      "schema": { "$ref": "#/entities/adminNotificationSettings" },
      "description": "Super Admin email notification settings"
    },
    "/emailedAlerts/{alertDocId}": {
      "schema": { "$ref": "#/entities/emailedAlerts" },
      "description": "Deduplicated history of emailed Super Admin alerts"
    },
    "/adminEmailSettings/{settingId}": {
      "schema": { "$ref": "#/entities/adminEmailSettings" },
      "description": "Super Admin email notification preferences"
    }
  }
}
